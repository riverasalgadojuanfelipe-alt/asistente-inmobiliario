# Supabase / Postgres connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres

# Configuración de la aplicación
APP_NAME=Asistente Inmobiliario
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# CORS: en dev deja "*". En producción, pon el dominio del frontend
# (comma-separated si son varios): CORS_ORIGINS=https://tu-app.vercel.app
CORS_ORIGINS=*

# Google Gemini API (para búsqueda en lenguaje natural)
# Obtén una clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
